{
  "name": "@premortem/mcp",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx --tsconfig ../tsconfig.base.json src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@premortem/db": "workspace:*",
    "@premortem/domain": "workspace:*",
    "@premortem/orchestrator": "workspace:*",
    "mcp-use": "^1.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}

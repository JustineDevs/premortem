{
  "name": "@premortem/notifications",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "dist",
    "index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "tsx --tsconfig ../../tsconfig.base.json ../../scripts/fix-esm-imports.ts dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@premortem/integrations": "workspace:*",
    "@premortem/observability": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "incremental": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@premortem/security": [
        "../../packages/security/src"
      ],
      "@premortem/llm": [
        "../../packages/llm/src"
      ],
      "@premortem/db/actor-context": [
        "../../packages/db/src/actor-context"
      ],
      "@premortem/db/supabase-auth": [
        "../../packages/db/src/supabase-auth"
      ],
      "@premortem/db/workspace-auth": [
        "../../packages/db/src/workspace-auth"
      ],
      "@premortem/ingestion": [
        "../../packages/ingestion/src"
      ],
      "@premortem/observability": [
        "../../packages/observability/src"
      ],
      "@premortem/observability/boot": [
        "../../packages/observability/src/boot"
      ],
      "@premortem/observability/events": [
        "../../packages/observability/src/events"
      ],
      "@premortem/observability/server": [
        "../../packages/observability/src/server"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "isolatedModules": true,
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "middleware.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/vendor/**"
  ]
}

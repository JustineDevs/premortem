{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalEnv": [
    "ALIBABA_CLOUD_ECS_APP_DIR",
    "ALIBABA_CLOUD_ECS_HOST",
    "ALIBABA_CLOUD_ECS_PUBLIC_URL",
    "ALIBABA_CLOUD_ECS_SSH_PORT",
    "ALIBABA_CLOUD_ECS_SSH_USER",
    "ALIBABA_CLOUD_ECS_INSTANCE_ID",
    "ALIBABA_CLOUD_REGION_ID",
    "AUTH_JWT_SECRET",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "DIRECT_URL",
    "ENCRYPTION_KEY",
    "GEMINI_API_KEY",
    "GITLAB_BASE_URL",
    "GITLAB_CLIENT_ID",
    "GITLAB_CLIENT_SECRET",
    "GITLAB_EXTERNAL_PROJECT_ID",
    "GITLAB_TOKEN",
    "GITLAB_WEBHOOK_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_SECRET",
    "IDENTITY_HMAC_SECRET",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LLM_MODEL",
    "MCP_ALLOWED_ORIGINS",
    "MCP_BASE_URL",
    "MCP_UPSTREAM_URL",
    "NANGO_BASE_URL",
    "NANGO_SECRET_KEY",
    "NANGO_WEBHOOK_SIGNING_KEY",
    "NEO4J_PASSWORD",
    "NEO4J_URI",
    "NEO4J_USERNAME",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "PHOENIX_API_KEY",
    "PHOENIX_COLLECTOR_ENDPOINT",
    "PHOENIX_LLM_EVAL",
    "PHOENIX_MCP_BASE_URL",
    "PHOENIX_PROJECT_NAME",
    "PHOENIX_SYNC_DATASETS",
    "PHOENIX_SYNC_PROMPTS",
    "POSTHOG_API_KEY",
    "POSTHOG_HOST",
    "PREMORTEM_API_BASE_URL",
    "PREMORTEM_SITE_URL",
    "PREMORTEM_AUTH_DISABLED",
    "PREMORTEM_PRODUCTION_MODE",
    "SENTRY_DSN",
    "SENTRY_TRACES_SAMPLE_RATE",
    "SLACK_APP_ID",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_SANDBOX",
    "SLACK_SCOPE_TOKEN",
    "SLACK_SIGNING_SECRET",
    "SLACK_VERIFICATION_TOKEN",
    "STRIPE_PAYMENT_LINK_PRO_ANNUAL",
    "STRIPE_PAYMENT_LINK_PRO_MONTHLY",
    "STRIPE_PAYMENT_LINK_SCALE_ANNUAL",
    "STRIPE_PAYMENT_LINK_SCALE_MONTHLY",
    "STRIPE_PAYMENT_LINK_TEAM_ANNUAL",
    "STRIPE_PAYMENT_LINK_TEAM_MONTHLY",
    "STRIPE_PRICE_PRO",
    "STRIPE_PRICE_PRO_ANNUAL",
    "STRIPE_PRICE_SCALE",
    "STRIPE_PRICE_SCALE_ANNUAL",
    "STRIPE_PRICE_TEAM",
    "STRIPE_PRICE_TEAM_ANNUAL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "QWEN_API_KEY",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "SUPABASE_URL"
  ]
}

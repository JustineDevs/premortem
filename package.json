{
  "name": "premortem",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.base.json ./scripts/dev/run-local-stack.ts",
    "dev:ngrok-stripe": "tsx --tsconfig tsconfig.base.json ./scripts/dev/run-ngrok-stripe.ts",
    "dev:turbo": "turbo dev",
    "build": "turbo build",
    "build:web": "pnpm --dir apps/web build",
    "build:pages": "pnpm --dir apps/web build",
    "build:pages:raw": "pnpm --dir apps/web build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "scan:deadcode": "knip --production --no-exit-code",
    "scan:secrets": "tsx --tsconfig tsconfig.base.json ./scripts/devtools/trufflehog.ts",
    "devtools:scan": "pnpm run scan:deadcode && pnpm run scan:secrets",
    "eval:prompts": "pnpm --filter @premortem/agent-kit build && pnpm --filter @premortem/llm build && pnpm --filter @premortem/observability build && pnpm --filter @premortem/evals build && tsx --tsconfig tsconfig.base.json ./scripts/patch-promptfoo-opentelemetry.ts && promptfoo validate config -c packages/evals/promptfoo/promptfooconfig.yaml && promptfoo validate config -c packages/evals/promptfoo/promptfooconfig.validator.yaml && promptfoo validate config -c packages/evals/promptfoo/promptfooconfig.floor.yaml && promptfoo eval -c packages/evals/promptfoo/promptfooconfig.yaml -o packages/evals/promptfoo/results.finding-synthesizer.json --max-concurrency 1 && promptfoo eval -c packages/evals/promptfoo/promptfooconfig.validator.yaml -o packages/evals/promptfoo/results.issue-validator.json --max-concurrency 1 && promptfoo eval -c packages/evals/promptfoo/promptfooconfig.floor.yaml -o packages/evals/promptfoo/results.specialist-floor.json --max-concurrency 1 && tsx --tsconfig tsconfig.base.json ./scripts/verify-promptfoo-threshold.ts packages/evals/promptfoo/results.finding-synthesizer.json 0.95 && tsx --tsconfig tsconfig.base.json ./scripts/verify-promptfoo-threshold.ts packages/evals/promptfoo/results.issue-validator.json 0.95 && tsx --tsconfig tsconfig.base.json ./scripts/verify-promptfoo-threshold.ts packages/evals/promptfoo/results.specialist-floor.json 1",
    "db:generate": "bash ./scripts/prisma-env.sh generate",
    "db:migrate": "bash ./scripts/prisma-env.sh db push --skip-generate",
    "db:status": "bash ./scripts/prisma-env.sh db pull --print",
    "db:studio": "bash ./scripts/prisma-env.sh studio",
    "db:reset-audits": "tsx --tsconfig tsconfig.base.json ./scripts/dev/reset-local-audit-data.ts",
    "db:reassign-smoke": "tsx --tsconfig tsconfig.base.json ./scripts/dev/reassign-smoke-workspace.ts",
    "db:reset-billing": "tsx --tsconfig tsconfig.base.json ./scripts/dev/reset-local-billing.ts",
    "stripe:sync-catalog": "tsx --tsconfig tsconfig.base.json ./apps/web/scripts/stripe-sync-catalog.ts",
    "audit:local": "tsx --tsconfig tsconfig.base.json ./scripts/dev/run-local-audit.ts",
    "audit:gitlab": "tsx --tsconfig tsconfig.base.json ./scripts/gitlab/run-duo-audit.ts",
    "smoke:audit-flow": "bash ./scripts/smoke/run-audit-flow.sh",
    "smoke:onboarding-e2e": "PREMORTEM_SMOKE_USE_FIXTURE=1 tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-onboarding-e2e.ts",
    "smoke:full-app-stress": "PREMORTEM_SMOKE_USE_FIXTURE=1 tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-full-app-stress.ts",
    "smoke:production-readiness": "PREMORTEM_PRODUCTION_MODE=1 tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-production-readiness.ts",
    "smoke:verify-gitlab-publish": "tsx --tsconfig tsconfig.base.json ./scripts/smoke/debug-gitlab-publish-token.ts",
    "smoke:fixture": "PREMORTEM_SMOKE_USE_FIXTURE=1 tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-production-readiness.ts",
    "smoke:local": "bash ./scripts/smoke/run-local-stack.sh",
    "smoke:product-truth": "tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-product-truth.ts",
    "smoke:security-fixes": "tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-security-fixes.ts",
    "smoke:hackathon": "pnpm run smoke:product-truth",
    "smoke:arize": "pnpm run smoke:product-truth",
    "devpost:submission": "tsx --tsconfig tsconfig.base.json ./scripts/release/print-devpost-submission.ts",
    "smoke:agent-builder-runtime": "pnpm --filter @premortem/agent-builder build && tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-agent-builder-runtime.ts",
    "phoenix:bootstrap": "pnpm --filter @premortem/observability build && tsx --tsconfig tsconfig.base.json ./scripts/phoenix/bootstrap-platform.ts",
    "verify:env": "tsx --tsconfig tsconfig.base.json ./scripts/smoke/verify-env-utilization.ts",
    "verify:evidence-snippets": "tsx --tsconfig tsconfig.base.json ./scripts/verify-persisted-evidence-snippets.ts",
    "lint:deadcode": "knip --production",
    "docker:up": "tsx --tsconfig tsconfig.base.json ./scripts/docker/ensure-services.ts",
    "docker:up:sudo": "PREMORTEM_DOCKER_SUDO=1 tsx --tsconfig tsconfig.base.json ./scripts/docker/ensure-services.ts",
    "docker:down": "docker compose down",
    "docker:status": "tsx --tsconfig tsconfig.base.json ./scripts/docker/verify-services.ts",
    "docker:test-neo4j": "tsx --tsconfig tsconfig.base.json ./scripts/docker/test-neo4j.ts",
    "premortem": "node ./packages/cli/dist/index.js",
    "prepare": "tsx --tsconfig tsconfig.base.json ./scripts/setup-husky.ts",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "prisma": "^5.20.0",
    "promptfoo": "^0.121.17",
    "tsx": "^4.20.0",
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "uuid": "13.0.2",
      "@tootallnate/once": "2.0.1",
      "tar": "7.5.16",
      "postcss": "8.5.15",
      "dompurify": "3.4.10",
      "ws": "8.21.0",
      "form-data@2.5.5": "2.5.6",
      "form-data@4.0.4": "4.0.6"
    }
  }
}
